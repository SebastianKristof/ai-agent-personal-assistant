    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "gpt-4o"
            },
            {
              "name": "messages",
              "value": "=[\n  {\n    \"role\": \"system\",\n    \"content\": \"You are a task classifier for an AI personal assistant. Your job is to analyze the user's message and determine which type of task they are requesting. Respond with a JSON object containing the task_type and any extracted relevant information.\\n\\nTask types:\\n- idea: User wants to save an idea or thought for later reference\\n- todo: User wants to add a task to their todo list\\n- question_todos: User is asking about their existing todos or what they should do next\\n- research: User is asking a question that requires research or information lookup\\n- decision: User needs help making a decision\\n- social_post: User wants to create a social media post\\n- calendar: User wants to schedule, view, or modify calendar events\\n- email: User wants to send or draft an email\\n- unknown: If the message doesn't clearly fit into any category\\n\\nExample response format:\\n{\\n  \\\"task_type\\\": \\\"todo\\\",\\n  \\\"content\\\": \\\"Buy milk tomorrow\\\",\\n  \\\"priority\\\": \\\"medium\\\",\\n  \\\"due_date\\\": \\\"2023-06-15\\\"\\n}\\n\\nOnly include fields that are relevant to the task type and can be clearly extracted from the user's message. The fields will vary based on the task type.\"\n  },\n  {\n    \"role\": \"user\",\n    \"content\": \"{{ $json[\"message\"][\"text\"] }}\"\n  }\n]"
            },
            {
              "name": "temperature",
              "value": 0.2
            },
            {
              "name": "response_format",
              "value": "{ \"type\": \"json_object\" }"
            }
          ]
        },
        "options": {}
      },
      "name": "Classify Task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        740,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "2",
          "name": "OpenAI API Key"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "// Parse the classification result\nconst responseContent = $input.item.json.choices[0].message.content;\nlet classification;\n\ntry {\n  classification = JSON.parse(responseContent);\n} catch (error) {\n  // If parsing fails, return an error\n  return {\n    json: {\n      task_type: 'unknown',\n      error: 'Failed to parse classification result',\n      raw_response: responseContent\n    }\n  };\n}\n\n// Add the original message for context\nclassification.original_message = $input.item.json.message.text;\nclassification.chat_id = $input.item.json.message.chat.id;\nclassification.user_id = $input.item.json.message.from.id;\nclassification.username = $input.item.json.message.from.username || '';\n\nreturn { json: classification };"
      },
      "name": "Extract Classification",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        940,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json[\"task_type\"] }}",
              "value2": "idea"
            }
          ]
        }
      },
      "name": "Route by Task Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [
        1140,

        740,
        460
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json[\"message\"][\"chat\"][\"id\"] }}",
        "text": "={{ $json.response }}",
        "additionalFields": {}
      },
      "name": "Send Response",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        1340,
        300
      ],
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "provider": "openAi",
        "chatModel": "gpt-4o",
        "prompt": {
          "messages": [
            {
              "role": "system",
              "content": "You are a task classifier for a personal assistant system. Your job is to analyze the user's message and determine what type of task it is.\n\nTask types:\n- idea: User is sharing an idea, thought, or something to remember\n- research: User wants information or research on a topic\n- task: User wants to create a task or reminder\n- chat: General conversation or questions\n\nRespond with a JSON object containing:\n- task_type: The type of task (one of the above)\n- confidence: Your confidence in the classification (0-1)\n- category: A short category label for the task (e.g., \"work\", \"personal\", \"health\")\n- tags: An array of relevant tags\n- content: A cleaned/formatted version of the user's message if needed\n\nExample response:\n{\n  \"task_type\": \"idea\",\n  \"confidence\": 0.95,\n  \"category\": \"business\",\n  \"tags\": [\"startup\", \"product\"],\n  \"content\": \"Create a mobile app for tracking daily habits\"\n}"
            },
            {
              "role": "user",
              "content": "={{ $json.message.text }}"
            }
          ]
        },
        "options": {
          "responseFormat": "json"
        }
      },
      "name": "Classify Task",
      "type": "n8n-nodes-base.aiAgent",
      "typeVersion": 1,
      "position": [
        740,
        200
      ],
      "credentials": {
        "openAiApi": {
          "id": "1",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "// Parse the AI response\nlet classification;\ntry {\n  // If the response is already parsed JSON\n  if (typeof $input.item.json.response === 'object') {\n    classification = $input.item.json.response;\n  } else {\n    // If it's a string that needs parsing\n    classification = JSON.parse($input.item.json.response);\n  }\n} catch (error) {\n  // Default classification if parsing fails\n  classification = {\n    task_type: 'chat',\n    confidence: 0.5,\n    category: 'general',\n    tags: ['unclassified'],\n    content: $input.item.json.message.text\n  };\n}\n\n// Add original message and user info\nconst taskData = {\n  ...classification,\n  original_message: $input.item.json.message.text,\n  user_id: $input.item.json.message.chat.id.toString(),\n  username: $input.item.json.message.from.username || $input.item.json.message.from.first_name\n};\n\nreturn {\n  json: {\n    task_type: classification.task_type,\n    task_data: taskData\n  }\n};"
      },
      "name": "Process Classification",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        940,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.task_type }}",
              "operation": "equals",
              "value2": "idea"
            }
          ]
        }
      },
      "name": "Is Idea?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1140,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://localhost:5678/webhook/idea-handler",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "task_data",
              "value": "={{ $json.task_data }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Call Context-Aware Idea Handler",
